---
// Wide screens: the page doesn't scroll. Under the nav, the welcome and the readout stay put;
// under them the plane is a map, dragged sideways with the mouse (or a trackpad, the wheel,
// the arrow keys, or the tabs at its foot, which glide there). On the left, my space: every
// featured or still-forming project a star, sized by magnitude (live bright, in progress
// pulsing, soon faint), joined into the constellation of its field (Automata, Systemis,
// Creavis), and the outer spaces (the links), each a pixel ship exploring it.
// In the middle an Einstein–Rosen bridge: the grid's rows converge into a mouth, run through a
// wireframe throat and flare out of another. On the right, the archive: the archived projects
// as vstros on display, in a row. When the map crosses the bridge, the welcome rewrites itself,
// like a terminal, into the archive's. cosmos.ts draws the grid and the bridge and moves the map.
// Stars, planets and ships are one file each in src/content/; they open their card
// (Fichas.astro) or go to their link. Without JS the stars link to the Registro rows, and both
// spaces stack on one scrolling page, so nothing is out of reach.
// Under 860px only the welcome shows here: the Registro (Hud.astro) is the view on phones.
// Behind the welcome there, a sketch of the same sky (grid, constellation lines, stars and some
// dust), rendered at build time, faint and still: decoration only, never interactive.
import Mark from './ds/Mark.astro';
import Icon from './ds/Icon.astro';
import Ship from './ds/Ship.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { projects, placeholder, constellations } from '../data/projects';
import { spaces } from '../data/spaces';
import { coordsOf, magnitude, bridge, fields } from '../data/sky';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const stars = projects.map((p) => ({ p, id: p.catalog, at: p.place }));
const here = stars.filter((s) => !s.p.archived);
// The archive is a display case: its vstros in one row across the middle, in catalog order,
// evenly spaced (a file's x / y place its star in my space, not here).
const archived = stars.filter((s) => s.p.archived).map((s, i, all) => ({ ...s, spot: { x: ((i + 1) / (all.length + 1)) * 100, y: 40 } }));
const byId = new Map(stars.map((s) => [s.p.id, s.at]));
const lines = constellations.flatMap((c) =>
  c.members.slice(1).flatMap((m, i) => {
    const a = byId.get(c.members[i]);
    const b = byId.get(m);
    return a && b ? [{ a, b }] : [];
  }),
);
// My space's stars are the brightest things on the page, a size up from the ships (18px).
const size = { live: 27, wip: 18, soon: 14 } as const;
// The phones' sketch: the stars smaller, and a still dust of background stars (deterministic,
// so every build draws the same sky).
const sketchSize = { live: 9, wip: 7, soon: 5 } as const;
const dust = Array.from({ length: 56 }, (_, i) => {
  const r = (salt: number) => {
    let h = 2166136261 ^ salt;
    h = Math.imul(h ^ i, 16777619);
    h = Math.imul(h ^ (h >>> 13), 2246822507);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
  };
  return { x: +(r(1) * 100).toFixed(2), y: +(r(2) * 100).toFixed(2), o: +(0.25 + r(3) * 0.6).toFixed(2) };
});
const planetLabel = { live: t('planet.live'), wip: t('planet.wip'), soon: t('planet.soon') };
const outer = spaces.filter((s) => s.url);
const words = {
  here: { title: t('chart.title'), lead: t('chart.lead') },
  archive: { title: t('archive.title'), lead: t('archive.lead') },
};
---
<section class="cosmos" aria-labelledby="chart-title" data-cosmos data-parallax data-bridge={JSON.stringify(bridge)} style={`--bridge:${bridge.width}`}>
  <div class="cosmos__field" data-parallax-layer aria-hidden="true">
    <canvas class="cosmos__stars-bg" data-starfield></canvas>
  </div>

  <div class="cosmos__sketch" aria-hidden="true">
    <svg class="sketch__lines" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      {Array.from({ length: 11 }, (_, i) => <line class="sketch__grid" x1={(i + 1) * (100 / 12)} y1="0" x2={(i + 1) * (100 / 12)} y2="100" vector-effect="non-scaling-stroke" />)}
      {Array.from({ length: 5 }, (_, i) => <line class:list={['sketch__grid', i === 3 && 'sketch__floor']} x1="0" y1={(i + 1) * (100 / 6)} x2="100" y2={(i + 1) * (100 / 6)} vector-effect="non-scaling-stroke" />)}
      {lines.map(({ a, b }) => <line class="sketch__line" x1={a.x} y1={a.y} x2={b.x} y2={b.y} vector-effect="non-scaling-stroke" />)}
      {dust.map((d) => <rect class="sketch__dust" x={d.x} y={d.y} width="0.5" height="0.35" opacity={d.o} />)}
    </svg>
    <ul class="sketch__stars">
      {stars.map(({ p, at }) => <li class={`sketch__star sketch__star--${p.status}`} style={`--x:${at.x};--y:${at.y}`}><Mark size={sketchSize[p.status]} /></li>)}
    </ul>
  </div>

  <div class="cosmos__head" data-words={JSON.stringify(words)}>
    <div class="cosmos__intro container" data-reveal>
      <h1 id="chart-title" class="display chart__title">
        <span class="visually-hidden">{words.here.title}</span>
        <span aria-hidden="true" data-transmute="title">{words.here.title}</span>
      </h1>
      <p class="text text--body-l text--muted chart__lead" data-transmute="lead">{words.here.lead}</p>
    </div>
    <div class="cosmos__bar container" aria-hidden="true">
      <p class="chart__readout" data-readout-out data-idle={t('chart.hint')}>{t('chart.hint')}</p>
      <ul class="chart__legend">
        <li><span class="star--live"><Mark size={12} /></span>{t('status.live')}</li>
        <li><span class="star--wip"><Mark size={10} /></span>{t('status.wip')}</li>
        <li><span class="star--soon"><Mark size={8} /></span>{t('status.soon')}</li>
      </ul>
    </div>
  </div>

  <div class="cosmos__viewport">
  <div class="cosmos__world" data-world>
    <svg class="cosmos__warp" aria-hidden="true" focusable="false" data-warp></svg>

    <div class="cosmos__space cosmos__space--here" id="here" data-space="here" tabindex="-1" aria-labelledby="chart-title">
      <div class="cosmos__upper" data-sky>
        <svg class="chart__grid chart__grid--lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          {lines.map(({ a, b }) => <line class="chart__line" x1={a.x} y1={a.y} x2={b.x} y2={b.y} vector-effect="non-scaling-stroke" />)}
        </svg>
        <ul class="chart__constellations" aria-hidden="true">
          {constellations.map((c) => <li style={`--x:${c.at.x};--y:${c.at.y}`}>{c.name}</li>)}
        </ul>
        <ol class="chart__stars" aria-label={t('chart.stars')}>
          {here.map(({ p, id, at }) => (
            <li class:list={['star', `star--${p.status}`, `star--${at.side}`]} style={`--x:${at.x};--y:${at.y}`}>
              <a
                class="star__link"
                href={`#${id.toLowerCase()}`}
                data-star={id.toLowerCase()}
                data-readout={`${id} · ${(p.title ?? placeholder.title)[lang]} · ${t('chart.magnitude')} ${magnitude[p.status]} · ${coordsOf(at.x, at.y)}`}
              >
                <span class="star__glyph"><Mark size={size[p.status]} /></span>
                <span class="star__label">
                  <span class="star__id">{id}</span>
                  <span class="star__name">{(p.title ?? placeholder.title)[lang]}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
        <!-- The outer spaces: each ship sets out from under the −20° line and explores the space. -->
        <ul class="outer__field" id="outer" aria-label={t('nav.elsewhere')}>
          {outer.map((s, i) => (
            <li class="outer__spot" style={`--x:${s.at.x};--y:${s.at.y}`}>
              <a class="outer__link" href={s.url} rel="noopener" data-outer-exit data-readout={`CH ${String(i + 1).padStart(2, '0')} · ${s.name[lang]} · ${s.handle}`}>
                <Ship kind={s.ship} size={18} class="outer__ship" />
                <span class="outer__label">
                  <span class="outer__name">{s.name[lang]}</span>
                  <span class="outer__handle">{s.handle}</span>
                </span>
                <Icon name="arrow-up-right" size={14} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="cosmos__bridge" aria-hidden="true" data-bridge-zone></div>

    <div class="cosmos__space cosmos__space--archive" id="archive" data-space="archive" tabindex="-1" aria-labelledby="archive-title">
      <h2 id="archive-title" class="cosmos__plane-title st-label">{t('space.archive')}</h2>
      <div class="cosmos__upper cosmos__upper--archive" data-sky>
        <ol class="chart__stars archive__stars" aria-label={t('space.archive')}>
          {archived.map(({ p, id, spot }) => (
            <li class:list={['star', 'star--archived', `star--${p.status}`]} style={`--x:${spot.x};--y:${spot.y}`}>
              <a
                class="star__link"
                href={`#${id.toLowerCase()}`}
                data-star={id.toLowerCase()}
                data-readout={`${id} · ${(p.title ?? placeholder.title)[lang]} · ${planetLabel[p.status]}`}
              >
                <span class="star__glyph"><Mark size={size[p.status]} /></span>
                <span class="star__label">
                  <span class="star__id">{id}</span>
                  <span class="star__name">{(p.title ?? placeholder.title)[lang]}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="bridge__ghosts" aria-hidden="true">
      {archived.map(() => <span class="bridge__ghost"><Mark size={7} /></span>)}
    </div>
  </div>
  </div>

  <div class="cosmos__tabs" data-map-tabs hidden>
    <button class="hud__tab" type="button" data-map-go="here" aria-label={`${t('map.go')}: ${t('space.here')}`}>{t('space.here')}</button>
    <button class="hud__tab" type="button" data-map-go="archive" aria-label={`${t('map.go')}: ${t('space.archive')}`}>{t('space.archive')}</button>
  </div>
</section>
