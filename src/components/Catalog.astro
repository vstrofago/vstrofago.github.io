---
// 01 Catalog: every star on the chart as a hairline row, in projects.ts order. It is the
// chart's plain-text twin: the stars link here, and it is what a screen reader, a search engine
// or a browser without JS gets. Each row carries its planet, drawn still; it turns while the
// row is hovered. "Look closer" (revealed by the script) opens the body's card.
import Label from './ds/Label.astro';
import Badge from './ds/Badge.astro';
import Icon from './ds/Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { projects, placeholder, type ProjectStatus } from '../data/projects';
import { placeOf, catalogId, constellationOf } from '../data/sky';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const linkLabel = { demo: t('catalog.demo'), github: t('catalog.github'), more: t('catalog.more') };
const status: Record<ProjectStatus, { label: string; dot?: boolean; outline?: boolean }> = {
  live: { label: t('status.live'), dot: true },
  wip: { label: t('status.wip') },
  soon: { label: t('status.soon'), outline: true },
};
---
<section id="catalog" class="section" aria-labelledby="catalog-title">
  <div class="container split">
    <div class="split__aside">
      <div class="split__sticky">
        <Label index="01">{t('catalog.label')}</Label>
        <h2 id="catalog-title" class="heading heading--2">{t('catalog.title')}</h2>
        <p class="text text--muted">{t('catalog.lead')}</p>
      </div>
    </div>
    <ol class="rows">
      {projects.map((p, i) => {
        const id = catalogId(i);
        const at = placeOf(p.id);
        const constellation = constellationOf(p.id);
        return (
          <li class="body" id={id.toLowerCase()}>
            <div class="body__planet" aria-hidden="true">
              <canvas
                class="planet"
                data-planet={p.id}
                data-status={p.status}
                data-kind={at.planet.kind}
                data-ring={at.planet.ring ? '' : undefined}
                data-moon={at.planet.moon ? '' : undefined}
                data-tilt={at.planet.tilt ?? 0}
                data-block-size="2"
              ></canvas>
            </div>
            <div class="body__main">
              <span class="body__id">{id}{constellation && <span class="body__constellation"> · {constellation}</span>}</span>
              <h3 class="heading heading--3">{(p.title ?? placeholder.title)[lang]}</h3>
              <p class="text text--muted">{(p.description ?? placeholder.description)[lang]}</p>
              <ul class="body__links">
                <li hidden data-closer>
                  <button class="st-btn st-btn--link" type="button" data-ficha-open={id.toLowerCase()}>
                    {t('catalog.closer')}<Icon name="search" size={14} />
                  </button>
                </li>
                {p.links.map((l) => (
                  <li><a class="st-btn st-btn--link" href={l.href} rel="noopener">{linkLabel[l.kind]}<Icon name="arrow-up-right" size={14} /></a></li>
                ))}
              </ul>
            </div>
            <div class="body__meta">
              <Badge dot={status[p.status].dot} outline={status[p.status].outline}>{status[p.status].label}</Badge>
              <span>{p.category[lang]}</span>
              <span>{p.tags ?? placeholder.tags[lang]}</span>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>
