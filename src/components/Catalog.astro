---
// 01 Catalog: the chart's plain-text twin, as a data table in a ship's-terminal frame (a
// hairline box, a mono status bar, an end-of-record line). One row per star, in projects.ts
// order; the stars link to these rows, and it is what a screen reader, a search engine or a
// browser without JS gets. "Look closer" (revealed by the script) opens the body's card.
// Under 720px the rows stack; the header is kept for assistive tech only.
import Label from './ds/Label.astro';
import Badge from './ds/Badge.astro';
import Icon from './ds/Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { projects, placeholder, type ProjectStatus } from '../data/projects';
import { catalogId, constellationOf } from '../data/sky';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const linkLabel = { demo: t('catalog.demo'), github: t('catalog.github'), more: t('catalog.more') };
const status: Record<ProjectStatus, { label: string; dot?: boolean; outline?: boolean }> = {
  live: { label: t('status.live'), dot: true },
  wip: { label: t('status.wip') },
  soon: { label: t('status.soon'), outline: true },
};
const count = String(projects.length).padStart(2, '0');
---
<section id="catalog" class="section" aria-labelledby="catalog-title">
  <div class="container split">
    <div class="split__aside">
      <div class="split__sticky">
        <Label index="01">{t('catalog.label')}</Label>
        <h2 id="catalog-title" class="heading heading--2">{t('catalog.title')}</h2>
        <p class="text text--muted">{t('catalog.lead')}</p>
      </div>
    </div>
    <div class="term">
      <div class="term__bar" aria-hidden="true">
        <span>{t('term.catalog')}</span>
        <span>{count} {t('term.records')}</span>
      </div>
      <table class="term__table term__table--catalog">
        <thead>
          <tr>
            <th scope="col">{t('table.id')}</th>
            <th scope="col">{t('table.body')}</th>
            <th scope="col">{t('table.class')}</th>
            <th scope="col">{t('table.status')}</th>
            <th scope="col">{t('table.links')}</th>
          </tr>
        </thead>
        <tbody>
          {projects.map((p, i) => {
            const id = catalogId(i);
            const constellation = constellationOf(p.id);
            return (
              <tr id={id.toLowerCase()}>
                <td class="term__id">{id}</td>
                <th scope="row" class="term__body">
                  <span class="term__name">{(p.title ?? placeholder.title)[lang]}</span>
                  <span class="term__desc">{(p.description ?? placeholder.description)[lang]}</span>
                </th>
                <td class="term__class">
                  <span>{p.category[lang]}</span>
                  <span class="term__sub">{p.tags ?? placeholder.tags[lang]}{constellation && ` · ${constellation}`}</span>
                </td>
                <td class="term__status">
                  <Badge dot={status[p.status].dot} outline={status[p.status].outline}>{status[p.status].label}</Badge>
                </td>
                <td class="term__links">
                  <ul>
                    <li hidden data-closer>
                      <button class="st-btn st-btn--link" type="button" data-ficha-open={id.toLowerCase()}>
                        {t('catalog.closer')}<Icon name="search" size={12} />
                      </button>
                    </li>
                    {p.links.map((l) => (
                      <li><a class="st-btn st-btn--link" href={l.href} rel="noopener">{linkLabel[l.kind]}<Icon name="arrow-up-right" size={12} /></a></li>
                    ))}
                  </ul>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <p class="term__end" aria-hidden="true">&gt; {t('term.end')}<span class="term__caret">_</span></p>
    </div>
  </div>
</section>
