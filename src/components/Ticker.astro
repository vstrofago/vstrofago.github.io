---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const words = useTranslations(lang)('ticker');
// The track holds the list four times and slides by half its width, so the loop is seamless.
const track = [...words, ...words, ...words, ...words];
---
<div class="ticker" aria-hidden="true">
  <div class="ticker__track">
    {track.map((w) => <span class="ticker__item">{w}</span>)}
  </div>
</div>
