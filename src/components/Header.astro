---
// Sticky nav. Transparent at rest; gains glass and a hairline only after scrolling (stoico.ts
// toggles .nav--scrolled). Wordmark left, three quiet links, then language and theme.
// Projects and Outer spaces are links to the Registro. On wide screens with JS (the plane's
// view) cosmos.ts turns each into a disclosure: a button that drops a plain list, for quick
// and accessible navigation. Projects open their card; outer spaces go to their link.
import Wordmark from './ds/Wordmark.astro';
import Icon from './ds/Icon.astro';
import Ship from './ds/Ship.astro';
import { languages, useTranslations, homeFor, type Lang } from '../i18n/ui';
import { blogUrl, spaces } from '../data/spaces';
import { projects, placeholder } from '../data/projects';
import { fields } from '../data/sky';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = homeFor(lang);
---
<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="nav__brand" href={home} aria-label={t('a11y.home')}><Wordmark size={18} /></a>
    <nav class="nav__links" aria-label={t('a11y.mainNav')}>
      <div class="nav__menu" data-nav-menu>
        <a class="nav__link" href={`${home}#hud-bodies`} data-menu-link>{t('nav.catalog')}</a>
        <button class="nav__trigger" type="button" aria-expanded="false" aria-controls="menu-projects" data-menu-trigger hidden>
          {t('nav.catalog')}<Icon name="chevron-down" size={12} />
        </button>
        <div class="nav__panel" id="menu-projects" data-menu-panel hidden>
          <ul>
            {projects.map((p) => (
              <li>
                <a class="nav__item" href={`${home}#${p.catalog.toLowerCase()}`} data-ficha-open={p.catalog.toLowerCase()}>
                  <span class="nav__item-id">{p.catalog}</span>
                  <span class="nav__item-name">{(p.title ?? placeholder.title)[lang]}</span>
                  <span class="nav__item-meta">{fields[p.field].name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <a class="nav__link" href={blogUrl}>{t('nav.notes')}</a>
      <div class="nav__menu" data-nav-menu>
        <a class="nav__link" href={`${home}#hud-exits`} data-menu-link>{t('nav.elsewhere')}</a>
        <button class="nav__trigger" type="button" aria-expanded="false" aria-controls="menu-outer" data-menu-trigger hidden>
          {t('nav.elsewhere')}<Icon name="chevron-down" size={12} />
        </button>
        <div class="nav__panel" id="menu-outer" data-menu-panel hidden>
          <ul>
            {spaces.filter((s) => s.url).map((s) => (
              <li>
                <a class="nav__item" href={s.url} rel="noopener">
                  <Ship kind={s.ship} size={14} class="nav__item-ship" />
                  <span class="nav__item-name">{s.name[lang]}</span>
                  <span class="nav__item-meta">{s.handle}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>
    <div class="nav__tools">
      <nav class="nav__lang" aria-label={t('a11y.langNav')}>
        {(Object.keys(languages) as Lang[]).map((code) => (
          <a href={homeFor(code)} hreflang={code} lang={code} aria-current={code === lang ? 'page' : undefined}>{languages[code]}</a>
        ))}
      </nav>
      <button
        class="st-btn st-btn--ghost st-btn--s st-btn--icon theme-toggle"
        type="button"
        data-theme-toggle
        data-label-light={t('theme.toLight')}
        data-label-dark={t('theme.toDark')}
        aria-label={t('theme.toLight')}
      >
        <Icon name="sun" size={14} class="theme-toggle__sun" />
        <Icon name="moon" size={14} class="theme-toggle__moon" />
      </button>
    </div>
  </div>
</header>
