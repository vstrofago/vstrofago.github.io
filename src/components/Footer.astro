---
// The footer is the page's one AsciiBanner: always ink (data-theme="dark", even in the
// light theme), the star eaten and reformed, and under it the wordmark and one line.
// No links: everything it could list is already in the nav and in Elsewhere.
import Wordmark from './ds/Wordmark.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<footer class="footer" data-theme="dark">
  <div class="ascii-banner" data-ascii-banner data-rows="22" data-size="11" aria-hidden="true">
    <pre class="ascii-banner__layer ascii-banner__background"></pre>
    <pre class="ascii-banner__layer ascii-banner__foreground"></pre>
    <pre class="ascii-banner__layer ascii-banner__accent"></pre>
  </div>
  <div class="container footer__inner">
    <Wordmark size={18} />
    <p class="text text--small text--subtle">{t('footer.note')}</p>
  </div>
</footer>
