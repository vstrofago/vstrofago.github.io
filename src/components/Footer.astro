---
// The footer is the page's one AsciiBanner: always ink (data-theme="dark", even in the
// light theme), the star eaten and reformed. Under it the wordmark, one line, how long the
// site has been in orbit (the date is static; cosmos.ts adds the day count).
import Wordmark from './ds/Wordmark.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
// The first commit of this site. The day count starts here.
const launch = '2026-09-23';
---
<footer class="footer" data-theme="dark">
  <div class="ascii-banner" data-ascii-banner data-rows="22" data-size="11" aria-hidden="true">
    <pre class="ascii-banner__layer ascii-banner__background"></pre>
    <pre class="ascii-banner__layer ascii-banner__foreground"></pre>
    <pre class="ascii-banner__layer ascii-banner__accent"></pre>
  </div>
  <div class="container footer__inner">
    <Wordmark size={18} />
    <p class="text text--small text--subtle">{t('footer.note')}</p>
    <p class="footer__orbit">
      {t('footer.orbit')} <time datetime={launch}>{launch}</time><span data-orbit-day={launch} data-label={t('footer.day')}></span>
    </p>
  </div>
</footer>
