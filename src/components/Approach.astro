---
// 02 Approach. Art as material: the words take five columns, a dithered plate takes three,
// set off-grid and dropped 64px for tension. The plate is a still BayerField standing in for a
// curated image; swap it for one with <Frame src=…> when there is one.
import Label from './ds/Label.astro';
import Frame from './ds/Frame.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="section section--tight-top" aria-labelledby="approach-title">
  <div class="container composition">
    <div class="composition__words">
      <Label index="02">{t('approach.label')}</Label>
      <h2 id="approach-title" class="heading heading--1 heading--pixel">{t('approach.title')}<br /><span class="text--muted">{t('approach.titleQuiet')}</span></h2>
      <p class="text text--muted text--measure">{t('approach.body')}</p>
    </div>
    <div class="composition__plate" data-reveal>
      <Frame ratio="3 / 4" index="Fig. 01" caption={t('approach.caption')} film>
        <div class="plate plate--ink"><canvas class="bayer-field" data-bayer data-cell="2" data-still></canvas></div>
      </Frame>
    </div>
  </div>
</section>
