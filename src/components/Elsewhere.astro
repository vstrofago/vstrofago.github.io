---
// 03 Elsewhere. Same split as Work; each row is one link.
import Label from './ds/Label.astro';
import Icon from './ds/Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { spaces } from '../data/spaces';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section id="elsewhere" class="section section--tight-top" aria-labelledby="elsewhere-title">
  <div class="container split">
    <div class="split__aside">
      <div class="split__sticky">
        <Label index="03">{t('elsewhere.label')}</Label>
        <h2 id="elsewhere-title" class="heading heading--2">{t('elsewhere.title')}</h2>
      </div>
    </div>
    <ul class="rows">
      {spaces.map((s) => (
        <li>
          {s.url ? (
            <a class="space" href={s.url} rel="noopener">
              <span class="space__name">{s.name[lang]}</span>
              <span class="space__handle">{s.handle}</span>
              <Icon name="arrow-up-right" class="space__arrow" />
            </a>
          ) : (
            <div class="space">
              <span class="space__name">{s.name[lang]}</span>
              <span class="space__handle">{s.handle}</span>
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
