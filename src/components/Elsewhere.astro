---
import Badge from './ds/Badge.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { spaces } from '../data/spaces';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const idx = (i: number) => String(i + 1).padStart(2, '0');
---
<section id="elsewhere" class="section" aria-labelledby="elsewhere-title">
  <div class="wrap">
    <div class="section__head">
      <div class="section__titles">
        <p class="bl-eyebrow">{t('elsewhere.kicker')}</p>
        <h2 id="elsewhere-title" class="bl-subtitle">{t('elsewhere.title')}</h2>
      </div>
      <p class="section__lead">{t('elsewhere.lead')}</p>
    </div>

    <ul class="rows" role="list">
      {spaces.map((s, i) => (
        <li>
          {s.url ? (
            <a class="row" href={s.url} rel="me noopener">
              <span class="row__idx">{idx(i)}</span>
              <span class="row__name">{s.name[lang]}</span>
              <span class="row__desc">{s.description[lang]}</span>
              <span class="row__handle">{s.handle}</span>
              <span class="row__go bl-label">{t('elsewhere.visit')}</span>
            </a>
          ) : (
            <div class="row row--soon">
              <span class="row__idx">{idx(i)}</span>
              <span class="row__name">{s.name[lang]}</span>
              <span class="row__desc">{s.description[lang]}</span>
              <span class="row__handle" aria-hidden="true">{s.handle}</span>
              <span class="row__go"><Badge tone="outline">{t('status.soon')}</Badge></span>
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
