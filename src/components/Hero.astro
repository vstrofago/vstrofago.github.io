---
// Aura hero, mode A02 Atmospheric: ink ground, the MarbleField masked toward the right,
// Display XL with the quiet half of the line in --fg-muted, and the page's one Ember moment:
// the accent button. The field follows the cursor by at most 14px (stoico.ts).
import Button from './ds/Button.astro';
import { useTranslations, homeFor, type Lang } from '../i18n/ui';
import { blogUrl } from '../data/spaces';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="hero" aria-labelledby="hero-title" data-parallax>
  <div class="hero__field" data-parallax-layer aria-hidden="true">
    <canvas class="marble-field" data-marble data-block-size="4"></canvas>
  </div>
  <div class="container hero__content">
    <h1 id="hero-title" class="display display--xl hero__title" data-reveal>
      {t('hero.title')}<br /><span class="hero__quiet">{t('hero.titleQuiet')}</span>
    </h1>
    <div class="hero__foot" data-reveal style="--reveal-delay:80ms">
      <p class="text text--body-l text--muted hero__lead">{t('hero.lead')}</p>
      <div class="hero__actions">
        <Button variant="accent" size="l" href={`${homeFor(lang)}#work`} iconRight="arrow-right">{t('hero.ctaWork')}</Button>
        <Button variant="ghost" size="l" href={blogUrl}>{t('hero.ctaNotes')}</Button>
      </div>
    </div>
  </div>
</section>
