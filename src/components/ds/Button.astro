---
// Stoico <Button>, class for class (.st-btn). primary: the one main action on a surface;
// secondary / ghost for the rest; link for inline actions. `accent` exists in the system but
// this site is monochrome (site.css maps it to --fg), so it is not used.
// Sizes s (28) · m (36) · l (44). Renders <a> when given `href`.
import Icon from './Icon.astro';
import type { IconName } from '../../data/icons';

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'accent' | 'link';
  size?: 's' | 'm' | 'l';
  href?: string;
  icon?: IconName;
  iconRight?: IconName;
  external?: boolean;
  class?: string;
  [attr: string]: unknown;
}
const { variant = 'primary', size = 'm', href, icon, iconRight, external, class: cls, ...rest } = Astro.props;
const iconSize = size === 's' ? 14 : 16;
const classes = ['st-btn', `st-btn--${variant}`, size !== 'm' && `st-btn--${size}`, cls];
const Tag = href ? 'a' : 'button';
const linkAttrs = href ? { href, ...(external ? { rel: 'noopener' } : {}) } : { type: 'button' };
---
<Tag class:list={classes} {...linkAttrs} {...rest}>
  {icon && <Icon name={icon} size={iconSize} />}
  <slot />
  {iconRight && <Icon name={iconRight} size={iconSize} />}
</Tag>
