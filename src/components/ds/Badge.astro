---
// Stoico <Badge> (.st-badge): a status or a count, always with a word.
interface Props {
  tone?: 'default' | 'success' | 'warning' | 'danger' | 'info' | 'accent';
  dot?: boolean;
  outline?: boolean;
}
const { tone = 'default', dot, outline } = Astro.props;
---
<span class:list={['st-badge', tone !== 'default' && `st-badge--${tone}`, outline && 'st-badge--outline']}>
  {dot && <span class="st-badge__dot" aria-hidden="true"></span>}
  <slot />
</span>
