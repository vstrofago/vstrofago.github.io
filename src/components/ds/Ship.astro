---
// A 9×9 pixel ship, drawn like Mark.astro (crisp squares, currentColor). The outer spaces fly
// them: they lead to other spaces. Five hulls; `spaces.ts` picks one per link. Decorative.
export type ShipKind = 'rocket' | 'shuttle' | 'fighter' | 'saucer' | 'probe';
interface Props { kind: ShipKind; size?: number; class?: string }
const { kind, size = 18, class: cls } = Astro.props;
const HULLS: Record<ShipKind, string[]> = {
  rocket: [
    '....#....',
    '...###...',
    '...#.#...',
    '...###...',
    '..#####..',
    '..##.##..',
    '.#######.',
    '.#.#.#.#.',
    '...#.#...',
  ],
  shuttle: [
    '....#....',
    '...###...',
    '...###...',
    '..##.##..',
    '.#######.',
    '#########',
    '#.#####.#',
    '...#.#...',
    '..#...#..',
  ],
  fighter: [
    '#.......#',
    '#...#...#',
    '#..###..#',
    '#########',
    '#..#.#..#',
    '#..###..#',
    '#...#...#',
    '#.......#',
    '.........',
  ],
  saucer: [
    '.........',
    '...###...',
    '..#...#..',
    '.#######.',
    '#.#.#.#.#',
    '.#######.',
    '..#...#..',
    '.#.....#.',
    '.........',
  ],
  probe: [
    '....#....',
    '....#....',
    '..#####..',
    '###.#.###',
    '#.#####.#',
    '###.#.###',
    '..#####..',
    '...#.#...',
    '..#...#..',
  ],
};
const d = HULLS[kind]
  .flatMap((row, y) => [...row].map((c, x) => (c === '#' ? `M${x} ${y}h1v1H${x}z` : '')))
  .join('');
---
<span class:list={['ship', `ship--${kind}`, cls]} aria-hidden="true">
  <svg viewBox="0 0 9 9" width={size} height={size} shape-rendering="crispEdges" focusable="false"><path d={d} fill="currentColor" /></svg>
</span>
