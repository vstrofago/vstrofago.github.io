---
// Stoico <Frame> (.st-frame): crops and captions an image or any media child (a dither plate).
// Radius 0, a mono index ("Fig. 01"), `film` adds the offset hairline.
interface Props { src?: string; alt?: string; ratio?: string; index?: string; caption?: string; film?: boolean; class?: string }
const { src, alt = '', ratio = '4 / 5', index, caption, film, class: cls } = Astro.props;
---
<figure class:list={['st-frame', film && 'st-frame--film', cls]}>
  <div class="st-frame__media" style={`aspect-ratio:${ratio}`}>
    {src ? <img src={src} alt={alt} loading="lazy" /> : <slot />}
  </div>
  {(caption || index) && (
    <figcaption class="st-frame__caption">
      {index && <span class="st-frame__index">{index}</span>}
      <span>{caption}</span>
    </figcaption>
  )}
</figure>
