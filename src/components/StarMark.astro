---
// The vstrofago pixel star (navbar mark). Same drawing as public/favicon.svg.
interface Props { size?: number }
const { size = 22 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 9 9" shape-rendering="crispEdges" aria-hidden="true" focusable="false" fill="var(--og)">
  <rect x="4" y="0" width="1" height="9"></rect>
  <rect x="0" y="4" width="9" height="1"></rect>
  <rect x="3" y="3" width="3" height="3"></rect>
  <rect x="2" y="2" width="1" height="1"></rect>
  <rect x="6" y="2" width="1" height="1"></rect>
  <rect x="2" y="6" width="1" height="1"></rect>
  <rect x="6" y="6" width="1" height="1"></rect>
</svg>
